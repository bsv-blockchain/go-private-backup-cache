PORT=8080

# 64-char hex secp256k1 private key. No default: the server refuses to start without it.
SERVER_PRIVATE_KEY=

# Omit to run on an in-memory store (development only — all data is lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backup_cache?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=json
# 100 MiB, matching the network's maximum transaction size policy. A single record can be
# large — the R1-K1 YubiKey vault locking script alone is ~960 KB, ~1.28 MB base64-encoded —
# and no client-side chunking can split one record. Budget ~3x this per concurrent upload
# in container memory: the auth middleware buffers the whole request to sign it.
# GET /v1/limits reports the effective value.
MAX_BLOB_BYTES=104857600
