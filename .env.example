PORT=8080

# 64-char hex secp256k1 private key. No default: the server refuses to start without it.
SERVER_PRIVATE_KEY=

# Omit to run on an in-memory store (development only — all data is lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backup_cache?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=json
# GET /v1/limits reports the effective value to clients. Default 200 MiB: a BSV
# transaction can reach 100 MB and the cap leaves room for honest encoding overhead.
# Safe at this size because bodies stream — memory use does not scale with it.
MAX_BLOB_BYTES=209715200

# OTLP/HTTP collector base URL, e.g. http://localhost:4318. Omit to disable telemetry
# export — logs still go to stdout either way. Traces and metrics are exported; span
# names use route patterns, never device IDs or pseudonyms.
OTEL_EXPORTER_OTLP_ENDPOINT=
