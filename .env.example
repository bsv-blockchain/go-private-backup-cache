PORT=8080

# 64-char hex secp256k1 private key. No default: the server refuses to start without it.
SERVER_PRIVATE_KEY=

# Omit to run on an in-memory store (development only — all data is lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backup_cache?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=json
# GET /v1/limits reports the effective value to clients.
MAX_BLOB_BYTES=1048576
