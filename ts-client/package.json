{
  "name": "@bsv/backup-cache-client",
  "version": "0.1.0",
  "description": "TypeScript client for the go-private-backup-cache service: stateless per-request auth proofs over streaming encrypted blobs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/go-private-backup-cache.git",
    "directory": "ts-client"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"const fs=require('fs');for(const f of ['NOTICE'])fs.copyFileSync('../'+f,f)\"",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@bsv/auth": "^0.1.8"
  },
  "peerDependencies": {
    "@bsv/sdk": "^3.0.0"
  },
  "devDependencies": {
    "@bsv/sdk": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
